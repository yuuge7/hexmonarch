{
  "version": 8,
  "id": "tactical-light",
  "name": "HexMonarch Tactical (sunlight white)",
  "metadata": {
    "attribution": "Data © OpenStreetMap contributors (ODbL) · Tiles © OpenMapTiles (CC-BY 4.0) · hosting OpenFreeMap"
  },
  "sources": {
    "openmaptiles": { "type": "vector", "url": "https://tiles.openfreemap.org/planet" }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#FFFFFF" } },

    { "id": "landcover_wood", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["in", "class", "wood", "grass", "farmland"],
      "paint": { "fill-color": "#EEF3EC", "fill-opacity": 0.9 } },
    { "id": "park", "type": "fill", "source": "openmaptiles", "source-layer": "park",
      "paint": { "fill-color": "#E6EFE3" } },
    { "id": "landuse_rail", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["in", "class", "railway", "industrial", "commercial", "retail"],
      "minzoom": 12,
      "paint": { "fill-color": "#F1F2F5" } },

    { "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water",
      "paint": { "fill-color": "#B9D3EA" } },
    { "id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway",
      "paint": { "line-color": "#9DC0E0",
        "line-width": { "base": 1.3, "stops": [[10, 0.6], [16, 4]] } } },

    { "id": "building", "type": "fill", "source": "openmaptiles", "source-layer": "building",
      "minzoom": 14,
      "paint": { "fill-color": "#E4E7EC",
        "fill-opacity": { "stops": [[14, 0.0], [16, 0.95]] } } },
    { "id": "building_edge", "type": "line", "source": "openmaptiles", "source-layer": "building",
      "minzoom": 16,
      "paint": { "line-color": "#C3C9D3", "line-width": 0.7 } },

    { "id": "aeroway", "type": "line", "source": "openmaptiles", "source-layer": "aeroway",
      "minzoom": 11,
      "paint": { "line-color": "#C9CED6", "line-width": { "base": 1.4, "stops": [[11, 1], [17, 20]] } } },

    { "id": "road_path", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "minzoom": 14,
      "filter": ["in", "class", "path", "track"],
      "paint": { "line-color": "#9AA3B0", "line-dasharray": [1.5, 1.5],
        "line-width": { "base": 1.2, "stops": [[14, 0.6], [18, 2]] } } },
    { "id": "road_minor", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "minzoom": 12,
      "filter": ["in", "class", "minor", "service"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#AEB6C2",
        "line-width": { "base": 1.4, "stops": [[12, 0.5], [15, 2.5], [18, 12]] } } },
    { "id": "road_secondary", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "minzoom": 9,
      "filter": ["in", "class", "secondary", "tertiary"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#8C96A5",
        "line-width": { "base": 1.4, "stops": [[9, 0.6], [14, 3], [18, 16]] } } },
    { "id": "road_primary", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "minzoom": 7,
      "filter": ["in", "class", "primary", "trunk"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#6F7A8A",
        "line-width": { "base": 1.4, "stops": [[7, 0.6], [13, 3], [18, 20]] } } },
    { "id": "road_motorway", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "minzoom": 5,
      "filter": ["==", "class", "motorway"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#566171",
        "line-width": { "base": 1.4, "stops": [[5, 0.5], [12, 3], [18, 24]] } } },

    { "id": "rail_ties", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "minzoom": 14,
      "filter": ["in", "class", "rail", "transit"],
      "paint": { "line-color": "#C5CBD5", "line-dasharray": [0.2, 3],
        "line-width": { "base": 1.4, "stops": [[14, 3], [18, 8]] } } },
    { "id": "rail", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "minzoom": 9,
      "filter": ["in", "class", "rail", "transit"],
      "paint": { "line-color": "#2B3442",
        "line-width": { "base": 1.4, "stops": [[9, 0.7], [15, 1.8], [18, 3]] } } },

    { "id": "boundary", "type": "line", "source": "openmaptiles", "source-layer": "boundary",
      "filter": ["<=", "admin_level", 6],
      "paint": { "line-color": "#8792A2", "line-dasharray": [3, 2],
        "line-width": { "stops": [[4, 0.6], [12, 1.4]] } } },

    { "id": "road_label", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name",
      "minzoom": 15,
      "filter": ["in", "class", "primary", "secondary", "tertiary", "minor", "trunk"],
      "layout": { "text-field": "{name}", "symbol-placement": "line", "text-size": 10,
        "text-letter-spacing": 0.1 },
      "paint": { "text-color": "#2B3442", "text-halo-color": "#FFFFFF", "text-halo-width": 1.4 } },
    { "id": "station_label", "type": "symbol", "source": "openmaptiles", "source-layer": "poi",
      "minzoom": 13,
      "filter": ["in", "class", "railway", "bus"],
      "layout": { "text-field": "{name}", "text-size": 11, "text-anchor": "top",
        "text-transform": "uppercase", "text-letter-spacing": 0.12 },
      "paint": { "text-color": "#10151D", "text-halo-color": "#FFFFFF", "text-halo-width": 1.6 } },
    { "id": "place_label", "type": "symbol", "source": "openmaptiles", "source-layer": "place",
      "maxzoom": 14,
      "filter": ["in", "class", "city", "town", "suburb", "neighbourhood"],
      "layout": { "text-field": "{name}", "text-transform": "uppercase", "text-letter-spacing": 0.2,
        "text-size": { "stops": [[6, 10], [12, 13]] } },
      "paint": { "text-color": "#10151D", "text-halo-color": "#FFFFFF", "text-halo-width": 1.6 } }
  ]
}
